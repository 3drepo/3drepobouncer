{
  "name": "3drepobouncerWorker",
  "version": "5.24.2",
  "engines": {
    "node": "24.x.x"
  },
  "private": true,
  "resolutions": {
    "ajv": "^6.14.0"
  },
  "scripts": {
    "start": "pm2 start src/scripts/bouncer_worker.js",
    "stop": "pm2 kill",
    "restart": "npm stop; npm start",
    "test": "c8 --check-coverage node --test --test-concurrency=1 --test-timeout=60000 tests/**/*.test.js",
    "lint": "eslint --rulesdir eslint-rules/ --ext .js src",
    "run-worker": "node src/scripts/bouncer_worker.js",
    "watch": "nodemon src/scripts/bouncer_worker.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "7.17.14",
    "amqplib": "0.10.7",
    "crypto-js": "4.2.0",
    "moment": "2.30.1",
    "nodemon": "3.1.14",
    "systeminformation": "5.33.1",
    "tree-kill": "1.2.2",
    "uuid": "11.1.1",
    "winston": "3.18.2",
    "yargs": "16.2.0",
    "yup": "1.7.0"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "eslint": "8.35.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-require-sort": "1.3.0",
    "eslint-plugin-security": "1.7.1"
  }
}