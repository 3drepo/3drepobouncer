# Deploy overrides read by dockerBuildAndPush.yml for the /deploy-bouncer PR-comment path.
# These are passed to _deploy.yml and only take effect on a staging test deploy.
#
# RELEASE_NAME: helm release name for a parallel test bouncer. Keep it as www-bouncer
#   on staging/master so the real staging bouncer is never affected; set a unique name
#   (e.g. issue1427-bouncer) on a test branch.
# CUSTOM_HELM_OVERRIDE: comma-separated `helm --set` overrides. Example pointing a test
#   bouncer at a separate rabbitmq with KEDA disabled:
#   rabbitmq.host=amqp://...@rabbitmq-313-headless:5672,autoscaling.enabled=false
RELEASE_NAME=www-bouncer
CUSTOM_HELM_OVERRIDE=
